<!doctype html>
<html lang="ko">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>장소 버튼과 Google 지도</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 20px;
            color: #17223b;
            background: #f7f8fc;
            font: 17px/1.65 system-ui, sans-serif;
        }

        h1 {
            font-size: 1.5rem;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button,
        .action {
            padding: 8px 16px;
            margin: 4px;
            border: 1px solid #7455e9;
            border-radius: 10px;
            color: #30205c;
            background: white;
            cursor: pointer;
        }

        button:hover,
        button[aria-pressed="true"] {
            background: #ece6ff;
        }

        button:focus-visible,
        a:focus-visible {
            outline: 3px solid #c56200;
        }

        button:disabled {
            opacity: .5;
            cursor: default;
        }

        label {
            display: block;
            margin: 10px 0;
        }

        img {
            width: 100%;
            max-height: 260px;
            object-fit: contain;
        }

        .layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .stage {
            display: grid;
            place-items: center;
            min-height: 220px;
        }

        #planet {
            display: grid;
            place-items: center;
            border-radius: 50%;
            font-size: 40px;
        }

        #result {
            white-space: pre-line;
        }

        canvas {
            max-width: 100%;
        }

        #game {
            background: #ece6ff;
            touch-action: manipulation;
        }

        .chart {
            position: relative;
            height: 280px;
        }

        iframe {
            max-width: 100%;
            border: 0;
        }

        [hidden] {
            display: none !important;
        }

        @media (max-width: 600px) {
            .layout {
                grid-template-columns: 1fr;
            }

            body {
                padding: 12px;
            }
        }
    </style>

</head>

<body>
    <h1>장소 버튼과 Google 지도</h1>
    <p>장소를 선택하면 설명과 위치 표시가 함께 바뀝니다.</p>
    <nav id="buttons" aria-label="장소 선택"></nav>
    <section id="library" class="place">
        <h2>중앙도서관</h2>
        <p>책과 함께 쉬는 장소입니다. 자신의 사진과 2주차 설명을 여기에 넣으세요.</p>
    </section>
    <section id="garden" class="place" hidden>
        <h2>성심교정</h2>
        <p>계절을 발견하는 산책 장소입니다.</p>
    </section>
    <section id="cafe" class="place" hidden>
        <h2>휴식 공간</h2>
        <p>친구와 이야기를 나누는 장소입니다.</p>
    </section>
    <iframe id="map" title="선택 장소 Google 지도" width="600" height="320" referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    <p><a id="map-link" target="_blank" rel="noopener">지도 새 창에서 열기</a></p>
    <p>실습용 검색 지도입니다. 과제에는 실제 장소를 확인한 공유 → 지도 퍼가기 주소를 사용하세요.</p>
    <script>
        const places = [
            { id: "library", name: "중앙도서관", query: "가톨릭대학교 성심교정 중앙도서관", embed: "" },
            { id: "garden", name: "성심교정", query: "가톨릭대학교 성심교정", embed: "" },
            { id: "cafe", name: "휴식 공간", query: "가톨릭대학교 성심교정 학생회관", embed: "" }
        ];
        function selectPlace(place) {
            for (const section of document.querySelectorAll(".place")) {
                section.hidden = section.id !== place.id;
            }
            for (const button of document.querySelectorAll("#buttons button")) {
                button.setAttribute("aria-pressed", String(button.dataset.place === place.id));
            }
            // 과제에서는 embed에 '지도 퍼가기'에서 복사한 src 주소를 넣습니다.
            let address = place.embed;
            if (!address) {
                address = "https://maps.google.com/maps?q=" + encodeURIComponent(place.query) + "&output=embed";
            }
            document.querySelector("#map").src = address;
            document.querySelector("#map").title = place.name + " Google 지도";
            document.querySelector("#map-link").href =
                "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(place.query);
        }
        for (const place of places) {
            const button = document.createElement("button");
            button.textContent = place.name;
            button.dataset.place = place.id;
            button.addEventListener("click", function () {
                selectPlace(place);
            });
            document.querySelector("#buttons").append(button);
        }
        selectPlace(places[0]);
    </script>
</body>

</html>